@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Areas/Identity/Pages/_IdentityLayout.cshtml";
}

<div class="login-container" style="margin-top:70px;">
    <div class="login-box">
        <div class="login-right">
            <img src="~/css/hero.png" alt="Register Image" />
        </div>

        <div class="login-left">
            <div class="logo-container" style="display: flex; align-items: center; justify-content: center; margin-bottom: 60px;">
                <img src="~/css/logo.png" alt="Logo" style="max-width: 150px; margin-right: 10px;" />
                <h4 style="margin: 0; font-weight: bolder">Crypto</h4>
            </div>

            <div class="login-signup-links" style="text-align: center; margin-bottom: 50px;">
                <a href="/Identity/Account/Login" class="login-link" style="color: grey; text-decoration: none; padding: 0 10px;">Log In</a>
                <a href="/Identity/Account/Register" class="signup-link active" style="color: black; font-weight: bold; text-decoration: none; padding: 0 10px;">Sign Up</a>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <div style="display: flex; justify-content: space-between;">
                        <div style="flex: 1; margin-right: 10px;">
                            <label asp-for="Input.FirstName" class="form-label" style="font-weight: bold;">First Name</label>
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="firstname" aria-required="true" placeholder="First Name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div style="flex: 1;">
                            <label asp-for="Input.LastName" class="form-label" style="font-weight: bold;">Last Name</label>
                            <input asp-for="Input.LastName" class="form-control" autocomplete="lastname" aria-required="true" placeholder="Last Name" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label" style="font-weight: bold;">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label" style="font-weight: bold;">Password</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Input.ConfirmPassword" class="form-label" style="font-weight: bold;">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary login-button">Register</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
